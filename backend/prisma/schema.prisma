generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum SeatStatus {
  AVAILABLE
  HELD
  BOOKED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
}

model User {
  id            Int      @id @default(autoincrement())
  email         String   @unique
  googleId      String?  @unique
  emailVerified Boolean  @default(false)
  role          Role     @default(USER)
  createdAt     DateTime @default(now())

  heldSeats     Seat[]         @relation("SeatHolder")
  bookings      Booking[]
  refreshTokens RefreshToken[]
  payments      Payment[]
}

model Show {
  id        Int      @id @default(autoincrement())
  movieName String
  venue     String
  showtime  DateTime
  rows      Int
  columns   Int
  posterUrl String?
  createdAt DateTime @default(now())

  seats    Seat[]
  bookings Booking[]
  payments Payment[]
}

model Seat {
  id            Int        @id @default(autoincrement())
  showId        Int
  show          Show       @relation(fields: [showId], references: [id])
  rowLabel      String
  seatNumber    Int
  status        SeatStatus @default(AVAILABLE)
  heldById      Int?
  heldBy        User?      @relation("SeatHolder", fields: [heldById], references: [id])
  holdExpiresAt DateTime?
  price         Decimal    @db.Decimal(10, 2)

  bookingSeats BookingSeat[]

  @@unique([showId, rowLabel, seatNumber])
  @@index([showId, status])
}

model Booking {
  id          Int           @id @default(autoincrement())
  userId      Int
  user        User          @relation(fields: [userId], references: [id])
  showId      Int
  show        Show          @relation(fields: [showId], references: [id])
  status      BookingStatus @default(PENDING)
  totalPrice  Decimal       @db.Decimal(10, 2)
  createdAt   DateTime      @default(now())
  confirmedAt DateTime?
  cancelledAt DateTime?

  bookingSeats BookingSeat[]
  payment      Payment?

  @@index([userId])
}

model BookingSeat {
  bookingId Int
  booking   Booking @relation(fields: [bookingId], references: [id])
  seatId    Int
  seat      Seat    @relation(fields: [seatId], references: [id])

  @@id([bookingId, seatId])
}

model RefreshToken {
  id        Int       @id @default(autoincrement())
  userId    Int
  user      User      @relation(fields: [userId], references: [id])
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model OtpCode {
  id         Int       @id @default(autoincrement())
  email      String
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([email])
}

model Payment {
  id                Int           @id @default(autoincrement())
  userId            Int
  user              User          @relation(fields: [userId], references: [id])
  showId            Int
  show              Show          @relation(fields: [showId], references: [id])
  seatIds           Int[]
  razorpayOrderId   String        @unique
  razorpayPaymentId String?
  amount            Decimal       @db.Decimal(10, 2)
  status            PaymentStatus @default(PENDING)
  bookingId         Int?          @unique
  booking           Booking?      @relation(fields: [bookingId], references: [id])
  createdAt         DateTime      @default(now())

  @@index([userId])
}

model WebhookEvent {
  id          String   @id
  type        String
  processedAt DateTime @default(now())
}
